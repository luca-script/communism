{
    "name": "luca-script/communism",
    "description": "Communism.",
    "type": "project",
    "license": "0BSD",
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*"
    },
    "suggest": {
        "ext-ffi": "Required by Zendful's fallback backend when no Zendful\\Native implementation is installed.",
        "phpstan/phpstan": "The PHPStan plugin provided in extension.neon provides mixin analysis, which is highly recommended."
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Communism\\": "src/Communism/",
            "Communism_PHPStan\\": "src/Communism_PHPStan/",
            "Zendful\\": "src/Zendful/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Communism\\Ext\\": "ext/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyze",
        "analyze": "phpstan analyze",
        "coverage": "php coverage.php zendful",
        "coverage:zendful": "php coverage.php zendful",
        "coverage:communism": "php coverage.php communism",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff",
        "paratest": [
            "@paratest:communism",
            "@paratest:zendful"
        ],
        "paratest:communism": "pest --configuration=phpunit-communism.xml --parallel",
        "paratest:zendful": "pest --configuration=phpunit-zendful.xml --parallel",
        "paratest:mixin": "pest --configuration=phpunit-communism.xml --parallel --testsuite=Communism.Mixins",
        "paratest:reflect": "pest --configuration=phpunit-communism.xml --parallel --testsuite=Communism.Reflection",
        "paratest:bytecode": "pest --configuration=phpunit-communism.xml --parallel --testsuite=Communism.Bytecode",
        "paratest:internals": "pest --configuration=phpunit-communism.xml --parallel --testsuite=Communism.Internals",
        "paratest:maintenance": "pest --configuration=phpunit-communism.xml --parallel --testsuite=Communism.Maintenance",
        "paratest:zendful:api": "pest --configuration=phpunit-zendful.xml --parallel --testsuite=Zendful.PublicApi",
        "paratest:zendful:internals": "pest --configuration=phpunit-zendful.xml --parallel --testsuite=Zendful.Internals",
        "paratest:zendful:architecture": "pest --configuration=phpunit-zendful.xml --parallel --testsuite=Zendful.Architecture",
        "test": [
            "@test:communism",
            "@test:zendful"
        ],
        "test:communism": "pest --configuration=phpunit-communism.xml",
        "test:zendful": "pest --configuration=phpunit-zendful.xml",
        "test:mixin": "pest --configuration=phpunit-communism.xml --testsuite=Communism.Mixins",
        "test:reflect": "pest --configuration=phpunit-communism.xml --testsuite=Communism.Reflection",
        "test:bytecode": "pest --configuration=phpunit-communism.xml --testsuite=Communism.Bytecode",
        "test:internals": "pest --configuration=phpunit-communism.xml --testsuite=Communism.Internals",
        "test:maintenance": "pest --configuration=phpunit-communism.xml --testsuite=Communism.Maintenance",
        "test:zendful:api": "pest --configuration=phpunit-zendful.xml --testsuite=Zendful.PublicApi",
        "test:zendful:internals": "pest --configuration=phpunit-zendful.xml --testsuite=Zendful.Internals",
        "test:zendful:architecture": "pest --configuration=phpunit-zendful.xml --testsuite=Zendful.Architecture"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
