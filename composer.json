{
    "name": "luca-script/communism",
    "description": "Communism.",
    "type": "project",
    "license": "0BSD",
    "require": {
        "php": "^8.4",
        "ext-ffi": "*",
        "ext-mbstring": "*"
    },
    "suggest": {
        "phpstan/phpstan": "The PHPStan plugin provided in extension.neon provides mixin analysis, which is highly recommended."
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Communism\\": "src/Communism/",
            "Communism_PHPStan\\": "src/Communism_PHPStan/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Communism\\Ext\\": "ext/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyze",
        "analyze": "phpstan analyze",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff",
        "paratest": "pest --parallel",
        "paratest:mixin": "pest --parallel tests/Mixin",
        "paratest:reflect": "pest --parallel tests/Reflect",
        "paratest:bytecode": "pest --parallel tests/Bytecode",
        "paratest:internals": "pest --parallel tests/Internals",
        "paratest:maintenance": "pest --parallel tests/Maintenance",
        "test": "pest",
        "test:mixin": "pest tests/Mixin",
        "test:reflect": "pest tests/Reflect",
        "test:bytecode": "pest tests/Bytecode",
        "test:internals": "pest tests/Internals",
        "test:maintenance": "pest tests/Maintenance"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
